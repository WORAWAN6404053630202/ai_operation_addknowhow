#/Users/w.worawan/Downloads/ai-operation-microservice3_v2ori/requirements.in
#
# Source file for the version ranges the project accepts. This is NOT what Docker
# installs from — Docker installs from the generated, exact-pinned + hash-locked
# requirements.txt (targets linux/amd64 + Python 3.11, matching docker-compose.prod.yaml
# and the Dockerfile's `python:3.11-slim` base). Edit ranges here, then regenerate:
#
#   uv pip compile requirements.in --generate-hashes --python-version 3.11 \
#     --python-platform x86_64-unknown-linux-gnu -o requirements.txt
#
# (requirements.txt itself also carries this exact command in its own header.)
